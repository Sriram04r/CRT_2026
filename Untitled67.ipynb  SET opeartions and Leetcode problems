        "from typing import List\n",
        "import builtins\n",
        "\n",
        "class Solution:\n",
        "    def containsDuplicate(self, nums: List[int]) -> bool:\n",
        "        s = builtins.set()\n",
        "        for i in nums:\n",
        "            if i not in s:\n",
        "                s.add(i)\n",
        "            else:\n",
        "                return True\n",
        "        return False\n",
        "\n",
        "nums = [1, 2, 3, 4, 1]\n",
        "obj = Solution()\n",
        "res = obj.containsDuplicate(nums)\n",
        "print(res)"
