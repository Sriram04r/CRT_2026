        "class Solution:\n",
        "\n",
        "    def isPalindrome(self, s: str) -> bool:\n",
        "        s2=\"\"\n",
        "        for i in s:\n",
        "            if i.isalnum():\n",
        "                if i.isalpha():\n",
        "                    ch=i.lower()\n",
        "                    s2=s2+ch\n",
        "                else:\n",
        "                    s2=s2+i\n",
        "        n=len(s2)\n",
        "        for i in range(n//2):\n",
        "            if s2[i]!=s2[n-1-i]:\n",
        "                return False\n",
        "        return True\n",
        "s2 = 'MADAMA'\n",
        "obj = Solution()\n",
