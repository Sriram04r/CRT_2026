        "def bs(list, target, i, j):\n",
        "    if i > j:\n",
        "        return -1\n",
        "    mid = (i + j) // 2\n",
        "    if list[mid] == target:\n",
        "        return mid\n",
        "    elif list[mid] > target:\n",
        "        return bs(list, target, i, mid - 1)\n",
        "    else:\n",
        "        return bs(list, target, mid + 1, j)\n",
        "\n",
