      "cell_type": "code",
      "source": [
        "def bs(data_list, key, i, j):\n",
        "  if i > j:\n",
        "    return -1\n",
        "\n",
        "  mid = (i + j) // 2\n",
        "  if data_list[mid] == key:\n",
        "    return mid\n",
        "  elif data_list[mid] > key:\n",
        "    return bs(data_list, key, i, mid - 1)\n",
        "  else:\n",
        "    return bs(data_list, key, mid + 1, j)\n",
        "\n",
        "unsorted_list = [1,4,7,9,3]\n",
        "\n",
        "data_list = sorted(unsorted_list)\n",
        "print(f\"Sorted list: {data_list}\")\n",
        "\n",
        "key = 3\n",
        "\n",
        "res_sorted_index = bs(data_list, key, 0, len(data_list) - 1)\n",
        "\n",
        "if res_sorted_index != -1:\n",
        "  original_index = unsorted_list.index(key)\n",
        "  print(f\"Key {key} found at original index: {original_index}\")\n",
        "else:\n",
        "  print(f\"Key {key} not found in the list.\")\n"
      ],
