        "def mergeSort(l,st,end):\n",
        "    if st==end:\n",
        "        return\n",
        "    mid=(st+end)//2\n",
        "    mergeSort(l,st,mid)\n",
        "    mergeSort(l,mid+1,end)\n",
        "    i=st\n",
        "    j=mid+1\n",
        "    l2=[]\n",
        "    while i<=mid and j<=end:\n",
        "        if l[i]<=l[j]:\n",
        "            l2.append(l[i])\n",
        "            i+=1\n",
        "        else:\n",
        "            l2.append(l[j])\n",
        "            j+=1\n",
        "    if i>mid:\n",
        "        while j<=end:\n",
        "            l2.append(l[j])\n",
        "            j+=1\n",
        "    elif j>end:\n",
        "        while i<=mid:\n",
        "            l2.append(l[i])\n",
        "            i+=1\n",
        "    for i in range(st,end+1):\n",
        "        l[i]=l2.pop(0)\n",
        "l=[2,8,1,4,9,8,2,6]\n",
        "mergeSort(l,0,len(l)-1)\n",
        "print(l)"
