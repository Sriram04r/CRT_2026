    {
      "cell_type": "code",
      "source": [
        "def rec(n):\n",
        "    if n == 0:\n",
        "        return 0\n",
        "    temp = n % 10\n",
        "    rem = n // 10\n",
        "    res = rec(rem)\n",
        "    if temp > res:\n",
        "        return temp\n",
        "    else:\n",
        "        return res\n",
        "a = rec(24)\n",
        "print(a)"
